{
  "name": "sankore",
  "version": "0.1.0",
  "description": "Boîte à outils de paiement pour l'Afrique de l'Ouest — mobile money, banque, microfinance, portefeuille et carte sous un seul contrat.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "RelayOps <contact@relayops.africa>",
  "keywords": [
    "payment",
    "mobile-money",
    "west-africa",
    "afrique",
    "orange-money",
    "wave",
    "moov",
    "mtn-momo",
    "xof",
    "fcfa",
    "microfinance",
    "bceao"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "demo": "node --experimental-strip-types demo.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "homepage": "https://relayops.africa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THIOYE97/sankore.git"
  },
  "bugs": {
    "url": "https://github.com/THIOYE97/sankore/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
